  "node": ["docx", "exceljs", "pptxgenjs"],
  "recipes": [
    { "ext": "dxf", "how": "ezdxf: doc = ezdxf.new('R2018', setup=True); msp = doc.modelspace(); add_line/add_lwpolyline/add_text, layers with doc.layers.add, dimensions with msp.add_linear_dim(...).render(); doc.saveas('outputs/plano.dxf'). Preview: from ezdxf.addons.drawing import matplotlib as dm; dm.qsave(msp, 'previews/plano.png', bg='#FFFFFF') (white sheet; export the same to outputs/plano.pdf for a printable plan). Set doc.units = ezdxf.units.M (or CM/MM) to match the user's dimensions." },
    { "ext": "png/svg/pdf chart", "how": "matplotlib (import matplotlib; matplotlib.use('Agg')): fig.savefig('outputs/x.png', dpi=200, bbox_inches='tight'); seaborn for statistics." },
    { "ext": "html interactive chart", "how": "plotly: fig.write_html('outputs/x.html', include_plotlyjs=True) — the file works offline." },
    { "ext": "pdf", "how": "reportlab (precise layout) or weasyprint (HTML + CSS: weasyprint.HTML(string=html).write_pdf('outputs/x.pdf')); an office file to PDF: soffice --headless --convert-to pdf --outdir outputs <file>." },
    { "ext": "odt/ods/odp/rtf/epub", "how": "build the docx/xlsx/pptx, then soffice --headless --convert-to odt|ods|odp|rtf --outdir outputs <file>; epub: pandoc in.md -o outputs/x.epub or ebooklib." },
    { "ext": "svg/diagram", "how": "Graphviz: write a .dot and run dot -Tsvg -o outputs/x.svg (or -Tpng); free drawings with svgwrite; SVG to PNG with cairosvg or rsvg-convert." },
    { "ext": "stl/obj/glb", "how": "trimesh (trimesh.creation.box/cylinder, boolean-free unions with trimesh.util.concatenate); mesh.export('outputs/x.stl')." },
    { "ext": "kml/gpx/geojson", "how": "simplekml, gpxpy; GeoJSON with json + shapely.geometry.mapping." },
    { "ext": "gif/mp4", "how": "draw frames with matplotlib or Pillow, then imageio.mimsave('outputs/x.gif', frames) or ffmpeg -framerate 12 -i previews/f%03d.png outputs/x.mp4." },
    { "ext": "mp3/wav/mid", "how": "pydub/ffmpeg for audio, scipy.io.wavfile for synthesized tones, mido for MIDI." },
    { "ext": "qr/barcode", "how": "qrcode.make(data).save('outputs/qr.png'); barcode.get('code128', data, writer=ImageWriter()).save('outputs/code')." },
    { "ext": "ics/csv/json/yaml/parquet/sqlite/sav", "how": "icalendar; pandas to_csv/to_json/to_parquet(engine='fastparquet')/to_sql (sqlite3); pyreadstat.write_sav." }
  ]
}
