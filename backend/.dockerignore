# ggml-base.bin is intentionally NOT ignored so Lenovo can pass
# --build-arg BUNDLE_WHISPER_MODEL=1 with a cached copy in this context.
node_modules
.env*
.mcp.json
.git
.gitignore
*.log
*.pem
*.jks
*.keystore
coverage
# tests/ is not in the image. Production boot must not require() fixtures from
# here (see rlcd/eval-harness.js — load is lazy / fail-open).
tests
uploads
prisma/*.db*
data
eval-results
logs
deployments-backup.json
.npm
tmp
temp
.cache
.DS_Store
