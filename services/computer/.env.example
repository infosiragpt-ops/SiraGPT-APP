# Orchestrator (run on the Docker host, e.g. /opt/siragpt/services/computer)
COMPUTER_ORCH_PORT=18080
COMPUTER_ORCH_BIND=127.0.0.1
COMPUTER_ORCH_SECRET=
COMPUTER_IMAGE=siragpt-computer:latest
# Idle reclaim is OFF: the member desktop stays up. Set 1 only if you
# want unused sira-acomp-* containers stopped (workspace volume is kept).
COMPUTER_IDLE_RECLAIM=0
COMPUTER_TTL_MS=86400000
COMPUTER_REAPER_MS=30000
COMPUTER_PERSIST_WORKSPACE=1
COMPUTER_NOVNC_BASE_URL=https://computer.siragpt.com
COMPUTER_PUBLIC_HOST=127.0.0.1
COMPUTER_MAX_SESSIONS=8
COMPUTER_VNC_PASSWORD=
