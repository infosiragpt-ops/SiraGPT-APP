modules = ["nodejs-22", "python-3.11", "postgresql-16"]

# Replit editor preview: Next.js dev server must listen on 0.0.0.0:3000.
run = "ALLOW_REPLIT_PREVIEW=1 npm run dev -- -H 0.0.0.0 -p 3000"
entrypoint = "package.json"
hidden = [".next", "node_modules", ".test-dist", ".playwright-cli", "output", "test-results"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "gce"
# Replit's GCE builder performs a root npm install before this command. Keep that
# root tree so it is not duplicated in a second image layer. The installer
# verifies the root build packages and falls back to npm ci if they are absent;
# backend production dependencies are installed separately.
#
# MEMORY: the builder is an 8 GiB e2-standard-2. `next build` was intermittently
# OOM-killed (SIGKILL, no error in the build log — it died right as next build
# started) when the V8 heap cap was 6144 MB, leaving too little headroom for
# native allocs + static-generation workers + OS. We pin NODE_OPTIONS=
# --max-old-space-size=4096 here (explicit, so an external NODE_OPTIONS can't
# bypass it) and enable experimental.webpackMemoryOptimizations in next.config.
build = "rm -rf backend/node_modules .next && NEXT_PUBLIC_API_URL=/api BACKEND_INTERNAL_URL=http://localhost:5050 REPLIT_BACKEND_MODE=sidecar BACKEND_PORT=5050 FRONTEND_PORT=3000 HUSKY=0 node scripts/replit-deploy-install.cjs && NEXT_PUBLIC_API_URL=/api BACKEND_INTERNAL_URL=http://localhost:5050 REPLIT_BACKEND_MODE=sidecar BACKEND_PORT=5050 FRONTEND_PORT=3000 REPLIT_DEPLOYMENT=1 NODE_OPTIONS=--max-old-space-size=4096 npm run build"
# start-all waits 50s for both children after SIGTERM/SIGINT. Override with
# SIRAGPT_PARENT_SHUTDOWN_TIMEOUT_MS (clamped to 40000-120000ms / 40-120s).
# Windows relays backend drain over IPC; process-tree force kill is deadline-only.
run = "NEXT_PUBLIC_API_URL=/api BACKEND_INTERNAL_URL=http://localhost:5050 REPLIT_BACKEND_MODE=sidecar BACKEND_PORT=5050 FRONTEND_PORT=3000 SIRAGPT_PARENT_SHUTDOWN_TIMEOUT_MS=50000 REPLIT_DEPLOYMENT=1 npm start"

[packager.features]
# The GCE builder owns the root install. The custom installer validates and reuses
# that tree, avoiding a duplicate multi-GB image layer while retaining a safe fallback.
enabledForHosting = true

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json"]

[languages.typescript]
pattern = "**/{*.ts,*.tsx}"
syntax = "typescript"

[unitTest]
language = "nodejs"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "oauth-url-smoke"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NEXT_PUBLIC_API_URL=/api BACKEND_INTERNAL_URL=http://localhost:5050 REPLIT_BACKEND_MODE=sidecar BACKEND_PORT=5050 FRONTEND_PORT=3000 NODE_ENV=development node -e \"const { spawn } = require('child_process'); const env = process.env; const backend = spawn('node', ['backend/scripts/start-with-migrations.js'], { cwd: '.', env: { ...env, PORT: '5050', HOST: '127.0.0.1', NODE_ENV: 'production' }, stdio: 'inherit' }); const frontend = spawn('npx', ['next', 'dev', '-p', '3000', '-H', '0.0.0.0'], { env: { ...env, PORT: '3000' }, stdio: 'inherit' }); const prewarm = spawn('node', ['scripts/prewarm-chunks.js'], { cwd: '.', env: { ...env, FRONTEND_PORT: '3000' }, stdio: 'inherit' });\""
waitForPort = 3000

[[workflows.workflow]]
name = "oauth-url-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node --test tests/oauth-url-policy.test.js"

[workflows.workflow.metadata]
isValidation = true

